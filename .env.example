# MAGNUS OS — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e preencha. Nunca faça commit de valores reais.
# Em staging/produção, configure no painel do provedor de hospedagem.

# --- Supabase (Fase 1) ---
# URL do projeto e chave publicável: podem ir ao navegador (a RLS protege os dados).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta: ignora RLS. Somente no worker e em jobs do servidor. NUNCA no app web.
SUPABASE_SECRET_KEY=
# Conexão Postgres direta usada pelo worker (fila e transações por execução).
DATABASE_URL=

# --- App web (apps/web/.env.local) ---
# Endereço público do app; base dos links enviados por e-mail. Precisa estar na lista de
# "Redirect URLs" do Supabase Auth (ex.: http://localhost:3000/**).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Rótulo do ambiente na barra superior: development | staging | production (production oculta o rótulo).
NEXT_PUBLIC_MAGNUS_ENV=development
# Mostra "Entrar com Google" somente depois de configurar o provedor Google no Supabase (F1.4c).
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# --- IA (Fase 2) ---
ANTHROPIC_API_KEY=
# Modelo padrão dos agentes até a decisão D-08.
MAGNUS_DEFAULT_MODEL=claude-opus-5-5
# Provedor de embeddings da memória: definido na decisão D-07 (Fase 3).
# EMBEDDINGS_API_KEY=

# --- Segurança (Fase 6) ---
# Chave mestra para cifrar credenciais de integrações (32 bytes em base64).
# MAGNUS_CREDENTIALS_KEY=
